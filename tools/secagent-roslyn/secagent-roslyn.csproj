<Project Sdk="Microsoft.NET.Sdk">

  <!-- secagent-roslyn: emits a secagent-analysis/v1 report from a C# solution/project using
       Roslyn + MSBuildWorkspace. Built into the secagent-analyzer-dotnet container image;
       see docs/design/heavy-analysis-pipeline.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>secagent-roslyn</AssemblyName>
    <RootNamespace>SecAgent.Roslyn</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.9.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.9.2" />
  </ItemGroup>

</Project>
