{
 "version": "2.1.0",
 "$schema": "http://json.schemastore.org/sarif-2.1.0",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "IKOS",
     "version": "3.4",
     "informationUri": "https://github.com/NASA-SW-VnV/ikos",
     "rules": [
      {
       "id": "buffer_overflow_analysis",
       "shortDescription": {
        "text": "checks for buffer overflows and out-of-bound array accesses."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "division_by_zero_analysis",
       "shortDescription": {
        "text": "checks for integer divisions by zero."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "null_pointer_analysis",
       "shortDescription": {
        "text": "checks for null pointer dereferences."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "assertion_prover",
       "shortDescription": {
        "text": "prove user-defined properties, using __ikos_assert(condition)."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "unaligned_pointer_analysis",
       "shortDescription": {
        "text": "checks for unaligned pointer dereferences."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "uninitialized_variable_analysis",
       "shortDescription": {
        "text": "checks for read of uninitialized variables."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "signed_integer_overflow_analysis",
       "shortDescription": {
        "text": "checks for signed integer overflows."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "unsigned_integer_overflow_analysis",
       "shortDescription": {
        "text": "checks for unsigned integer overflows."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "shift_count_analysis",
       "shortDescription": {
        "text": "checks for invalid shifts, where the amount shifted is greater or equal to the bit-width of the left operand, or less than zero."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "pointer_overflow_analysis",
       "shortDescription": {
        "text": "checks for pointer arithmetic overflows."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "pointer_comparison_analysis",
       "shortDescription": {
        "text": "checks for pointer comparisons between pointers referring to different objects."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "soundness_analysis",
       "shortDescription": {
        "text": "checks for instructions that could make the analysis unsound, i.e miss bugs."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "function_call_analysis",
       "shortDescription": {
        "text": "checks for function calls through function pointers of the wrong type."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "dead_code_analysis",
       "shortDescription": {
        "text": "checks for unreachable statements."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "double_free_analysis",
       "shortDescription": {
        "text": "checks for double free, invalid free, use after free and use after return."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "debugger",
       "shortDescription": {
        "text": "prints debug information, using __ikos_print_values(\"desc\", x) and __ikos_print_invariant()."
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      },
      {
       "id": "memory_watcher",
       "shortDescription": {
        "text": "prints memory writes at a given memory location, using __ikos_watch_mem(ptr, size)"
       },
       "helpUri": "https://github.com/NASA-SW-VnV/ikos/blob/master/analyzer/README.md#checks"
      }
     ]
    }
   },
